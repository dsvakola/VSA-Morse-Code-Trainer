<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store. build.bat fills in __VERSION__ from src-tauri/tauri.conf.json.
  Identity values must match Partner Center exactly (Product identity page).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="VidyasagarAcademy.VSAMorseCodeTrainer"
    Publisher="CN=E5EAB892-17BA-4AC0-A205-3AE9F2BA13DD"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>VSA Morse Code Trainer</DisplayName>
    <PublisherDisplayName>Vidyasagar Academy</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Learn Morse code by ear, by key, by heart. Free, offline and open source.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="VSAMorseCodeTrainer"
      Executable="VSA Morse Code Trainer.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="VSA Morse Code Trainer"
        Description="Learn Morse code by ear, by key, by heart."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
